        // Removed scrollableContent reference

        // --- State ---
        let currentQuestionIndex = 0;
        let selectedAnswerIndex = null;
        let score = 0;
        let quizFinished = false; // Tracks if the current question has been checked

        // --- Functions ---

        // Function to display the current question and options
        function displayQuestion() {
            quizFinished = false;
            selectedAnswerIndex = null;
            const currentQuestion = quizData[currentQuestionIndex];
            questionTextEl.textContent = currentQuestion.question;
            questionCounterEl.textContent = `Frage ${currentQuestionIndex + 1} von ${quizData.length}`;

            optionsContainerEl.innerHTML = '';
            feedbackEl.textContent = '';
            feedbackEl.className = 'feedback';

            currentQuestion.options.forEach((option, index) => {
                const button = document.createElement('button');
                button.textContent = option;
                button.className = 'option-btn';
                button.dataset.index = index;
                button.addEventListener('click', handleOptionSelect);
                optionsContainerEl.appendChild(button);
            });

            // Reset button states
            checkBtn.disabled = true;
            checkBtn.classList.remove('hidden');
            nextBtn.classList.add('hidden');

            // Ensure the main quiz container is visible
             quizContainer.style.display = 'block'; // Use block as flex is removed from card
             quizCompleteContainer.classList.add('hidden');

             // Scroll window to top to see the question
             window.scrollTo(0, 0);
        }

        // Function to handle option selection (before checking)
        function handleOptionSelect(event) {
            if (quizFinished) return;

            const selectedButton = event.target;
            selectedAnswerIndex = parseInt(selectedButton.dataset.index);

            const optionButtons = optionsContainerEl.querySelectorAll('.option-btn');
            optionButtons.forEach(btn => {
                btn.classList.remove('selected', 'correct', 'incorrect');
            });

            selectedButton.classList.add('selected');
            checkBtn.disabled = false;
        }

        // Function to check the selected answer
        function checkAnswer() {
            if (selectedAnswerIndex === null) return;

            quizFinished = true;
            const correctIndex = quizData[currentQuestionIndex].correctAnswerIndex;
            const optionButtons = optionsContainerEl.querySelectorAll('.option-btn');

            optionButtons.forEach((btn, index) => {
                btn.disabled = true;
                btn.classList.remove('selected');

                if (index === correctIndex) {
                    btn.classList.add('correct');
                } else if (index === selectedAnswerIndex) {
                    btn.classList.add('incorrect');
                }
            });

            if (selectedAnswerIndex === correctIndex) {
                score++;
                feedbackEl.textContent = 'Richtig!';
                feedbackEl.classList.add('correct');
            } else {
                feedbackEl.textContent = 'Falsch!';
                feedbackEl.classList.add('incorrect');
            }

            checkBtn.classList.add('hidden');
            checkBtn.disabled = true; // Ensure it's disabled
            nextBtn.classList.remove('hidden');

            if (currentQuestionIndex === quizData.length - 1) {
                nextBtn.textContent = 'Ergebnis anzeigen';
            } else {
                nextBtn.textContent = 'Nächste Frage';
            }
             // Scroll to the feedback/button area after checking
             // Use try-catch in case element is not found (shouldn't happen here)
             try {
                feedbackEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
             } catch (e) {
                console.error("Could not scroll to feedback:", e);
             }
        }


        // Function to go to the next question or show results
        function nextQuestion() {
            if (currentQuestionIndex < quizData.length - 1) {
                currentQuestionIndex++;
                displayQuestion();
            } else {
                 // Hide quiz, show completion screen
                 quizContainer.style.display = 'none'; // Hide quiz container
                 quizCompleteContainer.classList.remove('hidden');
                 quizCompleteContainer.style.display = 'block'; // Show completion screen

                 finalScoreEl.textContent = score;
                 totalPossibleScoreEl.textContent = quizData.length;
                 // Scroll to top for completion message
                 window.scrollTo(0,0);
            }
        }

        // Function to restart the quiz
        function restartQuiz() {
            currentQuestionIndex = 0;
            score = 0;
            selectedAnswerIndex = null;
            quizFinished = false;
            displayQuestion(); // This will also make the quiz container visible again
        }

        // --- Event Listeners ---
        checkBtn.addEventListener('click', checkAnswer);
        nextBtn.addEventListener('click', nextQuestion);
        restartBtn.addEventListener('click', restartQuiz);

        // --- Initial Load ---
        displayQuestion();

    </script>

</body>
</html>
